{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equityiq-finnhub-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 15, "period": 60 }
    }
  ]
}
